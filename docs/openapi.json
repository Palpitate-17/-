    "version": "1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans": {
      "post": {
        "tags": [
          "scans"
        ],
        "summary": "Create Scan Endpoint",
        "operationId": "create_scan_endpoint_api_v1_scans_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
