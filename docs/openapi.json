  "components": {
    "schemas": {
      "CoverageItem": {
        "properties": {
          "module": {
            "type": "string",
            "title": "Module"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "checked_items": {
            "type": "integer",
            "title": "Checked Items",
            "default": 0
          },
          "findings": {
            "type": "integer",
            "title": "Findings",
            "default": 0
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms",
            "default": 0.0
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.3.0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "module",
          "status"
        ],
        "title": "CoverageItem"
      },
      "CustomSensitiveRule": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "match_type": {
            "type": "string",
            "enum": [
              "regex",
              "keyword"
            ],
            "title": "Match Type"
          },
          "pattern": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Pattern"
          },
          "keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Keywords"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity",
            "default": "medium"
          },
          "mask": {
            "type": "string",
            "enum": [
              "phone",
              "email",
              "token",
              "full"
            ],
            "title": "Mask",
            "default": "full"
          },
          "exclude_values": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Exclude Values"
          },
          "exclude_context_regex": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Exclude Context Regex"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "title": "Description",
            "default": "发现用户自定义敏感信息"
          },
          "remediation": {
            "type": "string",
            "maxLength": 300,
            "title": "Remediation",
            "default": "请人工确认并按需删除或脱敏。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "match_type"
        ],
        "title": "CustomSensitiveRule"
      },
      "FindingList": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "1.0"
          },
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "scan_status": {
            "$ref": "#/components/schemas/ScanStatus"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/FindingResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scan_id",
          "scan_status",
          "items"
        ],
        "title": "FindingList"
      },
      "FindingResponse": {
        "properties": {
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Confidence",
            "default": "medium"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "evidence_masked": {
            "type": "string",
            "title": "Evidence Masked"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "impact": {
            "type": "string",
            "title": "Impact"
          },
          "remediation": {
            "type": "string",
            "title": "Remediation"
          },
          "verification": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "rejected"
            ],
            "title": "Verification",
            "default": "pending"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "false_positive",
              "accepted_risk"
            ],
            "title": "Status",
            "default": "open"
          },
          "detector": {
            "type": "string",
            "title": "Detector"
          },
          "detector_version": {
            "type": "string",
            "title": "Detector Version",
            "default": "0.3.0"
          },
          "first_seen": {
            "type": "string",
            "format": "date-time",
            "title": "First Seen"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding_id",
          "scan_id",
          "fingerprint",
          "category",
          "rule_id",
          "severity",
          "url",
          "title",
          "evidence_masked",
          "description",
          "impact",
          "remediation",
          "detector",
          "first_seen",
          "last_seen"
        ],
        "title": "FindingResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RetestResponse": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "1.0"
          },
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "previous_status": {
            "type": "string",
            "title": "Previous Status"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding_id",
          "previous_status",
          "status",
          "checked_at",
          "reason"
        ],
        "title": "RetestResponse"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "succeeded",
          "skipped",
          "failed",
          "inconclusive"
        ],
        "title": "RunStatus"
      },
      "ScanAccepted": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "1.0"
          },
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "status": {
            "$ref": "#/components/schemas/ScanStatus"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "findings_url": {
            "type": "string",
            "title": "Findings Url"
          },
          "report_url": {
            "type": "string",
            "title": "Report Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scan_id",
          "status",
          "status_url",
          "findings_url",
          "report_url"
        ],
        "title": "ScanAccepted"
      },
      "ScanDetail": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "1.0"
          },
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": false
          },
          "status": {
            "$ref": "#/components/schemas/ScanStatus"
          },
          "target_url": {
            "type": "string",
            "title": "Target Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "pages_discovered": {
            "type": "integer",
            "title": "Pages Discovered",
            "default": 0
          },
          "pages_scanned": {
            "type": "integer",
            "title": "Pages Scanned",
            "default": 0
          },
          "findings_count": {
            "type": "integer",
            "title": "Findings Count",
            "default": 0
          },
          "coverage": {
            "items": {
              "$ref": "#/components/schemas/CoverageItem"
            },
            "type": "array",
            "title": "Coverage"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scan_id",
          "status",
          "target_url",
          "created_at"
        ],
        "title": "ScanDetail"
      },
      "ScanRequest": {
        "properties": {
          "target_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Target Url"
          },
          "authorization_confirmed": {
            "type": "boolean",
            "title": "Authorization Confirmed"
          },
          "allowed_hosts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Allowed Hosts"
          },
          "allowed_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Allowed Paths"
          },
          "denied_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Denied Paths"
          },
          "max_pages": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "default": 30
          },
          "max_depth": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Max Depth",
            "default": 2
          },
          "rate_limit_rps": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.2,
            "title": "Rate Limit Rps",
            "default": 2.0
          },
          "timeout_seconds": {
            "type": "number",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Timeout Seconds",
            "default": 10.0
          },
          "max_response_bytes": {
            "type": "integer",
            "maximum": 5000000.0,
            "minimum": 10000.0,
            "title": "Max Response Bytes",
            "default": 1000000
          },
          "lab_mode": {
            "type": "boolean",
            "title": "Lab Mode",
            "default": false
          },
          "sensitive_file_extensions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Sensitive File Extensions"
          },
          "custom_sensitive_rules": {
            "items": {
              "$ref": "#/components/schemas/CustomSensitiveRule"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Custom Sensitive Rules"
          },
          "baseline_ignore_selectors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Baseline Ignore Selectors"
          },
          "external_link_blocklist": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "External Link Blocklist"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_url",
          "authorization_confirmed"
        ],
        "title": "ScanRequest"
      },
      "ScanStatus": {
        "type": "string",
        "enum": [
          "queued",
          "validating",
          "crawling",
          "scanning",
          "analyzing",
          "reporting",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "ScanStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
