{
  "target_url": "http://127.0.0.1:8765/",
  "allowed_paths": ["/", "/about.html", "/public/config.txt"],
  "interval_seconds": 30,
  "team_modules": ["sensitive", "encoded_secret", "baseline", "external_links", "weak_configuration"],
  "baseline_ignore_selectors": ["[data-ignore=\"dynamic\"]"],
  "external_link_blocklist": ["blocked.example.invalid"],
  "sensitive_rules": [
    {
      "name": "api_key",
      "pattern": "\\bapi[_-]?key\\s*[:=]\\s*[A-Za-z0-9._-]{6,}"
    },
    {
      "name": "token",
      "pattern": "\\btoken\\s*[:=]\\s*[A-Za-z0-9._-]{6,}"
    },
    {
      "name": "secret",
      "pattern": "\\bsecret\\s*[:=]\\s*[A-Za-z0-9._-]{6,}"
    }
  ]
}
