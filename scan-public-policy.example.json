{
  "mode": "public_https",
  "data_kind": "public_synthetic_demo",
  "target_url": "https://YOUR-OWN-SITE.example/",
  "allowed_paths": ["/", "/about.html", "/public/config.txt"],
  "interval_seconds": 300,
  "sensitive_rules": [
    {"name": "api_key", "pattern": "\\bapi[_-]?key\\s*[:=]\\s*[A-Za-z0-9._-]{6,}"},
    {"name": "token", "pattern": "\\btoken\\s*[:=]\\s*[A-Za-z0-9._-]{6,}"}
  ]
}
